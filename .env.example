# --- LLM providers (router prefers OpenAI → Groq → Gemini) ---
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Behavior toggles ---
LOG_LEVEL=INFO
EMBED_STATE_HINT=true
REQUEST_BUDGET_S=25
RECOMMENDATION_TOP_K=5

# --- CORS — comma-separated allowed origins for the deployed frontend ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-vercel-url.vercel.app
